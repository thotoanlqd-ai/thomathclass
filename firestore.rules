// =========================================================
// LUẬT BẢO MẬT FIRESTORE — ThoMathClass
// =========================================================
// File này được deploy tự động bằng Firebase CLI:
//   firebase deploy --only firestore:rules
// KHÔNG cần copy-paste tay vào Firebase Console nữa.
// ADMIN_UID phải luôn khớp với ADMIN_UID trong firebase-config.js và functions/index.js.
// =========================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 5 chức vụ lớp được phép viết bài "Nhật ký lớp học" (ngoài admin) — PHẢI khớp
    // CLASS_ROLE_LABELS trong firebase-config.js và ALLOWED_ROLES trong storage.rules.
    function journalRoles() {
      return ["lop-truong", "lop-pho-hoc-tap", "lop-pho-ne-nep", "bi-thu", "thu-quy"];
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";
    }

    // ---- Nhiều lớp / một tài khoản ----
    // Hồ sơ gốc của học sinh là roster/{uid}, students/{uid}. Khi học thêm lớp khác bằng CÙNG tài khoản,
    // admin tạo hồ sơ phụ roster/{uid}~{classId}, students/{uid}~{classId} (điểm, nhận xét, rèn luyện riêng từng lớp).
    // studentId trong các collection dưới đây có thể là uid hoặc "{uid}~{classId}".
    function isOwnerOf(studentId) {
      return request.auth != null &&
             (request.auth.uid == studentId || studentId.matches(request.auth.uid + '~.*'));
    }

    // Người đang đăng nhập có thuộc lớp classId không (hồ sơ gốc hoặc hồ sơ phụ).
    function isMemberOfClass(classId) {
      return request.auth != null &&
             ((exists(/databases/$(database)/documents/roster/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/roster/$(request.auth.uid)).data.classId == classId) ||
              exists(/databases/$(database)/documents/roster/$(request.auth.uid + '~' + classId)));
    }

    // ---- Điểm rèn luyện (áp dụng cho các lớp trong renLuyenClasses(), mỗi lớp tách riêng) ----

    // PHẢI khớp RENLUYEN_CLASS_IDS trong renluyen.js và functions/index.js.
    function renLuyenClasses() {
      return ["10c-lqd", "tho-2k9-minhan"];
    }

    // Lớp 10C5 dùng config/renluyen; các lớp khác dùng config/renluyen_{classId}.
    function renLuyenConfigPath(classId) {
      return /databases/$(database)/documents/config/$(classId == "10c-lqd" ? "renluyen" : "renluyen_" + classId);
    }

    // Lớp (có rèn luyện) của hồ sơ học sinh studentId, dựa vào roster.
    function renLuyenClassOf(studentId) {
      return get(/databases/$(database)/documents/roster/$(studentId)).data.classId;
    }

    // Kiểm tra studentId (uid hoặc id hồ sơ phụ) có phải học sinh của 1 lớp có rèn luyện không.
    function isRenLuyenStudent(studentId) {
      return exists(/databases/$(database)/documents/roster/$(studentId)) &&
             renLuyenClassOf(studentId) in renLuyenClasses();
    }

    // Người được giao quyền chấm điểm rèn luyện CHO LỚP của studentId:
    // uid đăng nhập có trong nguoiDuocCham của config lớp đó.
    function isRenLuyenGraderFor(studentId) {
      return request.auth != null &&
             isRenLuyenStudent(studentId) &&
             exists(renLuyenConfigPath(renLuyenClassOf(studentId))) &&
             request.auth.uid in get(renLuyenConfigPath(renLuyenClassOf(studentId))).data.nguoiDuocCham;
    }

    // Dữ liệu hợp lệ cho 1 lượt chấm điểm rèn luyện mới.
    function validRenLuyenEntry() {
      return request.resource.data.diem is number &&
             request.resource.data.diem != 0 &&
             request.resource.data.lyDo is string &&
             request.resource.data.lyDo.size() > 0 &&
             request.resource.data.hocKy is string &&
             request.resource.data.hocKy.size() > 0 &&
             request.resource.data.nguoiChamUid == request.auth.uid &&
             request.resource.data.huy == false;
    }

    // Học sinh có quyền viết nhật ký: có roster, chức vụ thuộc journalRoles(),
    // và đúng classId của roster khớp classId truyền vào.
    function canWriteJournalFor(classId) {
      return request.auth != null &&
             ((exists(/databases/$(database)/documents/roster/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/roster/$(request.auth.uid)).data.classRole in journalRoles() &&
               get(/databases/$(database)/documents/roster/$(request.auth.uid)).data.classId == classId) ||
              (exists(/databases/$(database)/documents/roster/$(request.auth.uid + '~' + classId)) &&
               get(/databases/$(database)/documents/roster/$(request.auth.uid + '~' + classId)).data.get('classRole', '') in journalRoles()));
    }

    // roster: danh sách công khai (chỉ tên + lớp), ai cũng xem được
    // nhưng CHỈ giáo viên mới được thêm/sửa/xoá
    match /roster/{studentId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";
    }

    // students: dữ liệu riêng tư (điểm số, nhận xét)
    // chỉ chính học sinh đó (đã đăng nhập đúng tài khoản) hoặc giáo viên mới đọc được
    // chỉ giáo viên mới được ghi/sửa
    match /students/{studentId} {
      allow read: if isOwnerOf(studentId) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";
    }

    // products: thông tin công khai của sản phẩm (tiêu đề, mô tả, giá, tag...)
    // ai cũng xem được (để hiện công khai trên web), chỉ giáo viên mới thêm/sửa/xoá
    // KHÔNG chứa link tải thật — link tải nằm ở subcollection "private" bên dưới
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";

      // private/content: link tải / link Azota thật.
      // Chỉ đọc được nếu là giáo viên, HOẶC thành viên đó đã có bản ghi mua
      // (members/{uid}/purchases/{productId}) — tức đã mua hoặc đã dùng lượt miễn phí.
      match /private/{docId} {
        allow read: if request.auth != null &&
                       (request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72" ||
                        exists(/databases/$(database)/documents/members/$(request.auth.uid)/purchases/$(productId)));
        allow write: if request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";
      }
    }

    // members: hồ sơ thành viên (học sinh trong lớp + khách hàng đăng ký ngoài).
    // Mỗi người tự đọc/ghi hồ sơ của chính mình (để cập nhật lastLoginAt/loginCount
    // ngay lúc đăng nhập). Giáo viên đọc được tất cả để xem mục "Quản lý thành viên".
    match /members/{uid} {
      allow read: if request.auth != null &&
                     (request.auth.uid == uid || request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72");
      allow write: if request.auth != null && request.auth.uid == uid;

      // purchases: lịch sử đã mua / đã dùng miễn phí sản phẩm nào.
      // CHỈ Cloud Functions (dùng Admin SDK, không qua rules) mới được ghi —
      // để không ai tự ghi giả "đã mua" mà chưa thanh toán thật.
      match /purchases/{productId} {
        allow read: if request.auth != null &&
                       (request.auth.uid == uid || request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72");
        allow write: if false;
      }
    }

    // orders: trạng thái giao dịch thanh toán payOS (pending/paid).
    // CHỈ Cloud Functions mới được tạo/sửa. Chủ đơn hàng hoặc giáo viên mới đọc được,
    // để trang web có thể lắng nghe realtime xem đơn đã thanh toán xong chưa.
    match /orders/{orderCode} {
      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.uid || request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72");
      allow write: if false;
    }

    // tuition: học phí hàng tháng của học sinh 3 lớp "Thầy Thọ vs 2k9/2k10/2k11".
    // Đọc được nếu là chính học sinh đó hoặc giáo viên. Giáo viên được ghi trực tiếp
    // (dùng để tick tay "đã đóng" khi nhận tiền mặt, giống cách roster/students đang cho phép) —
    // các field liên quan QR/webhook do Cloud Functions ghi bằng Admin SDK, không qua rules này.
    match /tuition/{tuitionId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.studentId || request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72");
      allow write: if request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";
    }

    // classJournal: bài viết "Nhật ký lớp học" (chữ + ảnh), áp dụng cho MỌI lớp trong CLASS_LIST
    // (kể cả lớp lập thêm sau này — không có danh sách lớp cố định ở đây).
    // Đọc được nếu là admin, hoặc học sinh có roster đúng classId của bài viết đó.
    // Tạo bài: admin, hoặc học sinh có chức vụ lớp (journalRoles()) đúng lớp mình —
    // và phải tự ghi đúng authorUid của mình (không giả mạo người khác).
    // Sửa/xoá: admin sửa/xoá được mọi bài; học sinh chỉ sửa/xoá được đúng bài do mình viết.
    match /classJournal/{entryId} {
      allow read: if request.auth != null &&
                     (isAdmin() || isMemberOfClass(resource.data.classId));
      allow create: if isAdmin() ||
                       (canWriteJournalFor(request.resource.data.classId) &&
                        request.resource.data.authorUid == request.auth.uid);
      allow update, delete: if isAdmin() || request.auth.uid == resource.data.authorUid;
    }

    // studentAvatars: ảnh đại diện học sinh — tách riêng khỏi students/roster.
    // Chính học sinh đó tự xem/đổi ảnh của mình sau khi đăng nhập; giáo viên xem/đổi được mọi ảnh.
    match /studentAvatars/{uid} {
      allow read, write: if request.auth != null &&
                             (request.auth.uid == uid || request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72");
    }

    // phan_anh: form "Phản ánh - Yêu cầu" — chỉ hiện trong khu vực lớp học (lophoc.html)
    // và khu vực khóa học đã mua (khoahoc.html) cho tài khoản đã đăng nhập. Rule chỉ chặn
    // ở mức "đã đăng nhập" khi tạo (không kiểm tra thành viên lớp/khóa học cụ thể ở đây —
    // việc đó đã lọc ở UI). Chỉ giáo viên (admin) đọc được danh sách và cập nhật trạng thái
    // (vd "Mới" -> "Đã xem") trong mục "Ý kiến phản hồi" ở trang quản trị — không ai khác
    // đọc/sửa/xoá được.
    match /phan_anh/{docId} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // config/renluyen (lớp 10C5) và config/renluyen_{classId} (các lớp khác): học kỳ hiện tại +
    // danh sách uid ĐĂNG NHẬP được giao quyền chấm điểm rèn luyện của lớp đó.
    // Đọc: bất kỳ ai đã đăng nhập (chỉ chứa 1 chuỗi học kỳ + danh sách uid, không nhạy cảm) —
    // học sinh cần đọc hocKyHienTai để hiện đúng học kỳ mặc định trên thẻ điểm rèn luyện của mình.
    // Ghi: chỉ admin (thêm/bớt người chấm, đổi học kỳ hiện tại).
    match /config/{configId} {
      allow read: if request.auth != null && configId.matches('renluyen.*');
      allow write: if isAdmin() && configId.matches('renluyen.*');
    }

    // students/{studentId}/renluyen/{entryId}: từng lượt chấm điểm rèn luyện.
    // Đọc: chính học sinh đó, hoặc admin. Người được giao quyền chấm KHÔNG đọc được lịch sử
    // chi tiết của người khác (theo yêu cầu), chỉ tạo mới được lượt chấm cho học sinh 10C5,
    // và phải tự ghi đúng nguoiChamUid của mình (không giả mạo người khác).
    // Sửa (huỷ lượt chấm nhầm bằng cách đánh dấu huy=true): chỉ admin. Không ai xoá hẳn được.
    match /students/{studentId}/renluyen/{entryId} {
      allow read: if isOwnerOf(studentId) || isAdmin();
      allow create: if isAdmin() ||
                       (isRenLuyenGraderFor(studentId) && validRenLuyenEntry());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // renluyenTong/{studentId}: tổng điểm rèn luyện từng học kỳ, vd {"HK1-2026-2027": 5}.
    // Tách riêng khỏi students/{uid} (vốn chứa điểm số/nhận xét riêng tư) để người được giao
    // quyền chấm đọc/ghi được tổng của học sinh 10C5 mà KHÔNG lộ dữ liệu riêng tư khác.
    // Đọc: chính học sinh đó, admin, hoặc người được giao quyền chấm (cần thấy tổng để chấm).
    // Ghi: admin (kể cả điều chỉnh khi huỷ lượt chấm), hoặc người được giao quyền chấm cho
    // đúng học sinh 10C5 (khi họ tạo lượt chấm mới, cùng lúc cộng/trừ vào tổng bằng transaction).
    match /renluyenTong/{studentId} {
      allow read: if isOwnerOf(studentId) || isAdmin() || isRenLuyenGraderFor(studentId);
      allow write: if isAdmin() || isRenLuyenGraderFor(studentId);
    }

    // leaderboard/10C5_<học kỳ>: bảng xếp hạng công khai TRONG LỚP — chỉ chứa
    // {hocKy, siSo, top:[{hang,ten,diem}]} (mọi em hạng <= 10, KHÔNG có lý do, KHÔNG có uid).
    // Đọc: học sinh 10C5 đã đăng nhập, hoặc admin. Ghi: chỉ Cloud Function (Admin SDK bỏ qua rules).
    match /leaderboard/{docId} {
      allow read: if request.auth != null &&
                     (isAdmin() || isMemberOfClass(resource.data.get('classId', '10c-lqd')));
      allow write: if false;
    }

    // classStats/{classId}: thống kê điểm kiểm tra cả lớp (TB, cao nhất, thấp nhất, số lượng theo khoảng điểm),
    // không chứa điểm từng em. Đọc: học sinh đúng lớp đó (theo roster) hoặc admin. Ghi: chỉ Cloud Function.
    match /classStats/{classId} {
      allow read: if request.auth != null && (isAdmin() || isMemberOfClass(classId));
      allow write: if false;
    }

    // renluyenHang/{studentId}: hạng + điểm học kỳ hiện tại của RIÊNG từng học sinh
    // ({hocKy, hang, diem, siSo}). Đọc: chính học sinh đó hoặc admin. Ghi: chỉ Cloud Function.
    match /renluyenHang/{studentId} {
      allow read: if isOwnerOf(studentId) || isAdmin();
      allow write: if false;
    }
  }
}
