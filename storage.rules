// =========================================================
// LUẬT BẢO MẬT FIREBASE STORAGE — ThoMathClass
// =========================================================
// Deploy bằng: firebase deploy --only storage
// ADMIN_UID phải luôn khớp với ADMIN_UID trong firebase-config.js/functions/index.js/firestore.rules.
// =========================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // classJournal: ảnh trong bài viết "Nhật ký lớp học".
    // Đọc được nếu là admin, hoặc học sinh có roster đúng classId (tra cứu chéo sang Firestore).
    // Chỉ admin được ghi (thêm/xoá ảnh khi đăng/sửa/xoá bài).
    match /classJournal/{classId}/{entryId}/{fileName} {
      allow read: if request.auth != null &&
                     (request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72" ||
                      (firestore.exists(/databases/(default)/documents/roster/$(request.auth.uid)) &&
                       firestore.get(/databases/(default)/documents/roster/$(request.auth.uid)).data.classId == classId));
      allow write: if request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";
    }

    // studentAvatars: ảnh đại diện học sinh — CHỈ giáo viên xem/tải lên, học sinh không đọc được.
    match /studentAvatars/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72";
    }

    // Mặc định chặn mọi đường dẫn khác.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
