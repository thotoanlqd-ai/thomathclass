// =========================================================
// LUẬT BẢO MẬT FIREBASE STORAGE — ThoMathClass
// =========================================================
// Deploy bằng: firebase deploy --only storage
// ADMIN_UID phải luôn khớp với ADMIN_UID trong firebase-config.js/functions/index.js/firestore.rules.
// =========================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // classJournal: ảnh trong bài viết "Nhật ký lớp học".
    // Đọc được nếu là admin, hoặc học sinh có roster đúng classId (tra cứu chéo sang Firestore).
    // Ghi được nếu là admin, hoặc học sinh có chức vụ lớp (khớp firestore.rules journalRoles())
    // đúng classId của path này.
    match /classJournal/{classId}/{entryId}/{fileName} {
      allow read: if request.auth != null &&
                     (request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72" ||
                      (firestore.exists(/databases/(default)/documents/roster/$(request.auth.uid)) &&
                       firestore.get(/databases/(default)/documents/roster/$(request.auth.uid)).data.classId == classId));
      allow write: if request.auth != null &&
                      (request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72" ||
                       (firestore.exists(/databases/(default)/documents/roster/$(request.auth.uid)) &&
                        firestore.get(/databases/(default)/documents/roster/$(request.auth.uid)).data.classRole in
                          ["lop-truong", "lop-pho-hoc-tap", "lop-pho-ne-nep", "bi-thu", "thu-quy"] &&
                        firestore.get(/databases/(default)/documents/roster/$(request.auth.uid)).data.classId == classId));
    }

    // studentAvatars: ảnh đại diện học sinh.
    // Chính học sinh đó tự đổi ảnh của mình (giới hạn 5MB, phải là file ảnh); giáo viên đổi được mọi ảnh.
    match /studentAvatars/{uid}/{fileName} {
      allow read: if request.auth != null &&
                     (request.auth.uid == uid || request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72");
      allow write: if request.auth != null &&
                      (request.auth.uid == "cbWUWVPZ8Fgni1gQjbz7ycJvfL72" ||
                       (request.auth.uid == uid &&
                        request.resource.size < 5 * 1024 * 1024 &&
                        request.resource.contentType.matches("image/.*")));
    }

    // Mặc định chặn mọi đường dẫn khác.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
